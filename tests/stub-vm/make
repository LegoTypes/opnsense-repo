#!/bin/sh
# A stand-in for "make -C <dir> package ...": writes the files named in
# $STUB_PKGS (space-separated) into <dir>/work/pkg/. Its arguments go to the file
# $STUB_MAKE_ARGS, one per line, when that is set, and then says where it ran to
# $STUB_MAKE_ARGS.tree: how the tree it is in was made (.fetched or .cloned), that tree's
# Mk/plugins.mk, and whether the package directory has its Makefile.
set -eu
[ -z "${STUB_MAKE_ARGS:-}" ] || printf '%s\n' "$@" >"$STUB_MAKE_ARGS"
if [ -n "${STUB_MAKE_ARGS:-}" ]; then
	t=$2
	while [ ! -d "$t/Mk" ] && [ "$t" != / ]; do t=$(dirname "$t"); done
	{
		cat "$t/.fetched" "$t/.cloned" 2>/dev/null || true
		cat "$t/Mk/plugins.mk" 2>/dev/null || echo "no Mk"
		if [ -f "$2/Makefile" ]; then echo "Makefile: yes"; else echo "Makefile: no"; fi
	} >"$STUB_MAKE_ARGS.tree"
fi
[ "$1" = -C ] && [ "$3" = package ] || {
	echo "stub make: unsupported: $*" >&2
	exit 2
}
for v in PLUGIN_ABI PLUGIN_PHP PLUGIN_PYTHON; do
	case " $* " in
	*" $v="[0-9]*) ;;
	*)
		echo "stub make: $v not passed" >&2
		exit 3
		;;
	esac
done
# STUB_FAIL_DIR: a directory whose build fails, as a broken package would
case $2 in
*"${STUB_FAIL_DIR:-//none//}") exit 1 ;;
esac
mkdir -p "$2/work/pkg"
# STUB_PKGS names the files to produce; unset, the package is os-<directory name>-1.0
for f in ${STUB_PKGS-os-$(basename "$2")-1.0.pkg}; do
	echo "package $f" >"$2/work/pkg/$f"
done

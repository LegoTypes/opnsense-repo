#!/bin/sh
# A stand-in for the pkg calls sign-catalogue.sh makes (pkg-tool.sh's pkg on the runner).
#   pkg repo <dir> signing_command: <cmd...>
#     speaks pkg's signing_command protocol: for data and packagesite.yaml it
#     feeds the file's sha256 (hex) to <cmd>, takes the bytes between
#     "SIGNATURE" and "CERT" as the signature and those between "CERT" and
#     "END" as the public key, and packs file, .sig and .pub into <name>.pkg
#     (data.pkg, packagesite.pkg), a tar archive compressed with zstd as pkg repo does
#     where the system's /usr/bin/bsdtar reads zstd itself (Ubuntu: libarchive with
#     libzstd), else with gzip (macOS's has no libzstd, and no zstd is in /usr/bin)
#   pkg info -F <file>   prints three lines naming the file
# With STUB_PKG_REFUSE set it runs nothing and fails (a test's proof that another pkg ran).
# STUB_PATH: the test harness's PATH, for openssl, perl, tar and zstd (sign-catalogue.sh
# runs pkg with PATH=/usr/bin:/bin). For "repo": STUB_PKG_FEED, a line fed to <cmd> in
# place of each digest; STUB_PKG_REPLY, the file <cmd>'s answer is written to;
# STUB_PKG_BLOCK, a file the stub writes its pid to before it sleeps (a cancelled run);
# STUB_PKG_TRUNCATE, set: the answer loses its last line (END) before it is read, as a
# signing command that answered only in part.
set -eu
PATH=${STUB_PATH:-$PATH}
if [ -n "${STUB_PKG_REFUSE:-}" ]; then
	echo "stub pkg: refused (STUB_PKG_REFUSE is set)" >&2
	exit 2
fi
case "$1 $2" in
"repo "*)
	dir=$2
	shift 3
	if [ -n "${STUB_PKG_BLOCK:-}" ]; then
		echo $$ >"$STUB_PKG_BLOCK"
		exec sleep 30
	fi
	compress='zstd -q -c'
	/usr/bin/bsdtar --version | grep -q libzstd || compress='gzip -c'
	for pair in data:data packagesite.yaml:packagesite; do
		file=${pair%%:*} archive=${pair#*:}
		work=$(mktemp -d)
		echo "catalogue $file" >"$work/$file"
		reply=${STUB_PKG_REPLY:-$work/reply}
		if [ -n "${STUB_PKG_FEED+set}" ]; then
			printf '%s\n' "$STUB_PKG_FEED" | "$@" >"$reply"
		else
			openssl dgst -sha256 -r "$work/$file" | cut -d' ' -f1 | "$@" >"$reply"
		fi
		if [ -n "${STUB_PKG_TRUNCATE:-}" ]; then
			perl -0777 -i -pe 's/END\n?\z//' "$reply"
		fi
		W="$work" perl -0777 -ne '
			/\ASIGNATURE\n(.*)\nCERT\n(.*)END\n?\z/s or die "stub pkg: malformed signing reply\n";
			open(my $s, ">", "$ENV{W}/sig") or die; print $s $1;
			open(my $p, ">", "$ENV{W}/pub") or die; print $p $2;
		' "$reply"
		mv "$work/sig" "$work/$file.sig"
		mv "$work/pub" "$work/$file.pub"
		tar -cf - -C "$work" "$file.sig" "$file.pub" "$file" | $compress >"$dir/$archive.pkg"
		rm -rf "$work"
	done
	echo 'version = 2;' >"$dir/meta.conf"
	;;
"info -F") printf 'Name : %s\nVersion : x\nOrigin : y\n' "$(basename "$3" .pkg)" ;;
*)
	echo "stub pkg: unsupported: $*" >&2
	exit 2
	;;
esac

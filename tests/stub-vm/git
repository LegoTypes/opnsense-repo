#!/bin/sh
# A stand-in for the git calls build-package.sh makes in the VM.
#   git init --quiet <dir>                                         makes the directory
#   git clone --quiet --depth 1 --branch <branch> <url> <dir>   records "<url> <branch>" in <dir>/.cloned, writes
#                                                                  Mk/plugins.mk, and makes every directory named in
#                                                                  STUB_GIT_FW_DIRS (url opnsense/plugins) or in
#                                                                  STUB_GIT_DIRS (any other url), each with a Makefile;
#                                                                  STUB_GIT_LINK makes that path a symlink there
#   git -C <dir> rev-parse HEAD                                    prints the commit last checked out, else a fixed one:
#                                                                  STUB_GIT_FW_HEAD for a clone of opnsense/plugins,
#                                                                  0123456789abcdef0123456789abcdef01234567 otherwise
#   git -C <dir> fetch --quiet --depth 1 origin <commit>           succeeds
#   git -C <dir> fetch --quiet --depth 1 <url> <sha>               records "<url> <sha>" in <dir>/.fetched and writes
#                                                                  <dir>/FETCH_HEAD: the sha, or STUB_GIT_FETCH_AS
#   git -C <dir> rev-parse FETCH_HEAD                              prints FETCH_HEAD
#   git -C <dir> checkout --quiet FETCH_HEAD                       moves HEAD to FETCH_HEAD, writes Mk/plugins.mk and
#                                                                  the STUB_GIT_FW_DIRS directories
#   git -C <dir> fetch --quiet --unshallow origin <refspec>        succeeds
#   git -C <dir> checkout --quiet <commit>                         moves HEAD there (to STUB_GIT_CHECKOUT_AS when set)
#   git -C <dir> merge-base --is-ancestor <commit> refs/remotes/origin/main
#                                                                  succeeds only for the checked-out commit and that
#                                                                  ref; fails when STUB_GIT_OFF_BRANCH is set
#   git -c safe.directory=<cwd> log -1 --format=%H -- <dir>        prints another fixed commit, the last change to <dir>
#   git -c safe.directory=<cwd> rev-parse --is-shallow-repository  prints false (true when STUB_GIT_SHALLOW is set)
# Every -C call is appended to $STUB_GIT_LOG when that is set. Anything else, including any other fetch or
# merge-base form, is unsupported (exit 2). A tree is a directory, not a repository: the stub keeps no history.
set -eu
fwurl=https://github.com/opnsense/plugins.git
# mkdirs <dir> <names>: each name as a directory with a Makefile
mkdirs() {
	local_d=$1
	shift
	for n in "$@"; do
		mkdir -p "$local_d/$n"
		echo "all:" >"$local_d/$n/Makefile"
	done
}
safe=''
if [ "$1" = -c ]; then
	case $2 in safe.directory=*) safe=${2#safe.directory=} ;; esac
	shift 2
fi
case $1 in
init)
	mkdir -p "$3"
	;;
clone)
	shift
	branch=''
	while [ $# -gt 2 ]; do
		[ "$1" = --branch ] && branch=$2
		shift
	done
	mkdir -p "$2"
	echo "$1 $branch" >"$2/.cloned"
	mkdir -p "$2/Mk"
	echo "Mk from $1" >"$2/Mk/plugins.mk"
	if [ "$1" = "$fwurl" ]; then
		# shellcheck disable=SC2086
		mkdirs "$2" ${STUB_GIT_FW_DIRS:-}
	else
		# shellcheck disable=SC2086
		mkdirs "$2" ${STUB_GIT_DIRS:-}
		# STUB_GIT_LINK: a symbolic link at that path (to /etc), as a hostile commit could hold
		if [ -n "${STUB_GIT_LINK:-}" ]; then
			mkdir -p "$(dirname "$2/$STUB_GIT_LINK")"
			ln -s /etc "$2/$STUB_GIT_LINK"
		fi
	fi
	;;
-C)
	dir=$2
	shift 2
	[ -z "${STUB_GIT_LOG:-}" ] || echo "$*" >>"$STUB_GIT_LOG"
	case $1 in
	rev-parse)
		case $2 in
		FETCH_HEAD) cat "$dir/FETCH_HEAD" ;;
		HEAD)
			if [ -f "$dir/.head" ]; then
				cat "$dir/.head"
			elif grep -q "^$fwurl " "$dir/.cloned" 2>/dev/null; then
				echo "${STUB_GIT_FW_HEAD:-fedcba9876543210fedcba9876543210fedcba98}"
			else
				echo 0123456789abcdef0123456789abcdef01234567
			fi
			;;
		*)
			echo "stub git: unsupported: -C $dir rev-parse $2" >&2
			exit 2
			;;
		esac
		;;
	fetch)
		# fetch --quiet --depth 1 <url> <sha>; the plugin clone's fetch from origin changes nothing here
		if [ $# -eq 6 ] && [ "$2" = --quiet ] && [ "$3" = --depth ] && [ "$4" = 1 ] && [ "$5" != origin ]; then
			echo "$5 $6" >"$dir/.fetched"
			echo "${STUB_GIT_FETCH_AS:-$6}" >"$dir/FETCH_HEAD"
		elif [ $# -eq 6 ] && [ "$2" = --quiet ] && [ "$3" = --depth ] && [ "$4" = 1 ] && [ "$5" = origin ]; then
			:
		elif [ $# -eq 5 ] && [ "$2" = --quiet ] && [ "$3" = --unshallow ] && [ "$4" = origin ]; then
			:
		else
			echo "stub git: unsupported: -C $dir $*" >&2
			exit 2
		fi
		;;
	checkout)
		[ $# -eq 3 ] && [ "$2" = --quiet ] || {
			echo "stub git: unsupported: -C $dir $*" >&2
			exit 2
		}
		if [ "$3" = FETCH_HEAD ]; then
			cp "$dir/FETCH_HEAD" "$dir/.head"
			mkdir -p "$dir/Mk"
			echo "Mk from $(cat "$dir/.fetched")" >"$dir/Mk/plugins.mk"
			# shellcheck disable=SC2086
			mkdirs "$dir" ${STUB_GIT_FW_DIRS:-}
		else
			echo "${STUB_GIT_CHECKOUT_AS:-$3}" >"$dir/.head"
		fi
		;;
	merge-base)
		[ $# -eq 4 ] && [ "$2" = --is-ancestor ] && [ "$3" = "$(cat "$dir/.head" 2>/dev/null)" ] &&
			[ "$4" = refs/remotes/origin/main ] || {
			echo "stub git: unsupported: -C $dir $*" >&2
			exit 2
		}
		[ -z "${STUB_GIT_OFF_BRANCH:-}" ]
		;;
	*)
		echo "stub git: unsupported: -C $dir $*" >&2
		exit 2
		;;
	esac
	;;
log)
	# as in the build VM: the workspace belongs to another user, so git refuses it unless the
	# caller passes -c safe.directory=<the workspace>
	[ "${safe:-}" = "$PWD" ] || {
		echo "fatal: detected dubious ownership in repository at '$PWD'" >&2
		exit 128
	}
	echo abcdef0123456789abcdef0123456789abcdef01
	;;
rev-parse)
	[ $# -eq 2 ] && [ "$2" = --is-shallow-repository ] && [ "${safe:-}" = "$PWD" ] || {
		echo "stub git: unsupported: $*" >&2
		exit 2
	}
	if [ -n "${STUB_GIT_SHALLOW:-}" ]; then echo true; else echo false; fi
	;;
*)
	echo "stub git: unsupported: $*" >&2
	exit 2
	;;
esac

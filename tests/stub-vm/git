#!/bin/sh
# A stand-in for the git calls build-package.sh makes in the VM.
#   git clone --quiet --depth 1 --branch <branch> <url> <dir>   records "<url> <branch>" in <dir>/.cloned
#   git -C <dir> rev-parse [--short] HEAD                          prints a fixed commit
#   git -c safe.directory=<cwd> log -1 --format=%H -- <dir>                                prints another fixed commit, the
#                                                                  last change to <dir> (nothing when
#                                                                  STUB_GIT_SHALLOW is set)
set -eu
safe=''
if [ "$1" = -c ]; then
	case $2 in safe.directory=*) safe=${2#safe.directory=} ;; esac
	shift 2
fi
case $1 in
clone)
	shift
	branch=''
	while [ $# -gt 2 ]; do
		[ "$1" = --branch ] && branch=$2
		shift
	done
	mkdir -p "$2"
	echo "$1 $branch" >"$2/.cloned"
	mkdir -p "$2/Mk"
	echo "Mk from $1" >"$2/Mk/plugins.mk"
	;;
-C) echo 0123456789abcdef0123456789abcdef01234567 ;;
log)
	# as in the build VM: the workspace belongs to another user, so git refuses it unless the
	# caller passes -c safe.directory=<the workspace>
	[ "${safe:-}" = "$PWD" ] || {
		echo "fatal: detected dubious ownership in repository at '$PWD'" >&2
		exit 128
	}
	[ -n "${STUB_GIT_SHALLOW:-}" ] || echo abcdef0123456789abcdef0123456789abcdef01
	;;
*)
	echo "stub git: unsupported: $*" >&2
	exit 2
	;;
esac

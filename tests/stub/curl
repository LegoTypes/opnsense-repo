#!/usr/bin/env bash
# A stand-in for curl. URLs under $STUB_MIRROR_URL are served from $STUB_MIRROR
# (a URL ending in / maps to that directory's index.html); every other URL, such
# as the file:// ones carry-forward.sh reads, goes to the real curl. Honours -o.
set -euo pipefail
args=("$@") out='' url=''
while [[ $# -gt 0 ]]; do
	case $1 in
	-o) out=$2 && shift 2 ;;
	-*) shift ;;
	*) url=$1 && shift ;;
	esac
done
if [[ -n ${STUB_MIRROR_URL:-} && $url == "$STUB_MIRROR_URL"* ]]; then
	path=${url#"$STUB_MIRROR_URL"}
	[[ $path == */ || -z $path ]] && path="${path}index.html"
	f="$STUB_MIRROR/$path"
	[[ -f $f ]] || {
		echo "curl: (22) The requested URL returned error: 404" >&2
		exit 22
	}
	if [[ -n $out ]]; then cp "$f" "$out"; else cat "$f"; fi
else
	exec /usr/bin/curl "${args[@]}"
fi
